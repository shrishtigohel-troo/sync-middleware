# =============================================================================
# Shopify - HubSpot Middleware - Environment Configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Shopify: B2B store -------------------------------------------------------
# Phase 1 target store. Domain form: your-store.myshopify.com
SHOPIFY_B2B_STORE_URL=
SHOPIFY_B2B_ACCESS_TOKEN=
SHOPIFY_B2B_API_VERSION=2024-10
# Shared secret used to verify Shopify webhook HMAC signatures for this store.
SHOPIFY_B2B_WEBHOOK_SECRET=

# --- Shopify: B2C store (Phase 3) --------------------------------------------
SHOPIFY_B2C_STORE_URL=
SHOPIFY_B2C_ACCESS_TOKEN=
SHOPIFY_B2C_API_VERSION=2024-10
SHOPIFY_B2C_WEBHOOK_SECRET=

# --- HubSpot ------------------------------------------------------------------
# Private App: "Shopify Custom Migration". Access token is the primary
# credential used for all API calls. Do not use the client secret unless a
# specific flow (e.g. OAuth) actually requires it.
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_API_BASE_URL=https://api.hubapi.com

# --- Retry / rate limiting -----------------------------------------------------
HTTP_MAX_RETRIES=5
HTTP_RETRY_BASE_DELAY_MS=500

# --- Migration / batch control --------------------------------------------------
MIGRATION_BATCH_SIZE=50
